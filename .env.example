
# Configurações do Discord
DISCORD_TOKEN=seu_discord_token
CLIENT_ID=seu_client_id
GUILD_ID=seu_guild_id

# Configurações da aplicação
APP_URL=http://localhost:3000

# Cargos do servidor Discord
ALUNO_ROLE_ID=seu_aluno_role_id
PROFESSOR_ROLE_ID=seu_professor_role_id
STATS_ROLE_ID=seu_stats_role_id

# Banco de dados PostgreSQL
DATABASE_URL=postgresql://usuario:senha@localhost:5432/nome_do_banco

# Inteligência Artificial
GEMINI_API_KEY=sua_chave_gemini
# Modelo(s) Gemini, separados por vírgula (tenta o próximo se um der 404). Opcional.
# GEMINI_MODEL=gemini-3.8-flash,gemini-3.5-flash

# Pesquisa de artigos
# OpenAlex EXIGE chave desde fev/2026 (gratuita): openalex.org > Settings > API key
OPENALEX_API_KEY=sua_chave_openalex
# E-mail de contato enviado ao Crossref (identifica o bot e melhora o limite de uso)
CONTACT_EMAIL=seu_email@exemplo.com
